, "recvcvztBCfzcQ", "recvcvzvadvXAP", "recvcvzyvx6z3f", "recvcvzAfowsal"], "table_id": "tbl73ZJc0gk9MCfg", "text": "JJ342,JJ343,JJ344,JJ345,JJ346", "text_arr": ["JJ342", "JJ343", "JJ344", "JJ345", "JJ346"], "type": "text"}]}, "note_content": "（缓存命中，从飞书主表复用）", "quality_score": null, "created_at": "2026-06-13 11:50:43", "processing_start": "2026-06-13 11:51:04", "completed_at": "2026-06-13 23:44:23", "images": {"cover": "temp/generated_images/img_20260613_234351_227152.png", "scene1": "temp/generated_images/img_20260613_234359_200936.png", "scene2": "temp/generated_images/img_20260613_234406_800808.png", "scene3": "temp/generated_images/img_20260613_234414_908334.png", "scene4": "temp/generated_images/img_20260613_234423_196326.png"}}
